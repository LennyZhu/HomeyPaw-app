# Do not load automatically. Copy outside the repo, chmod 600, fill ONLY Sandbox
# values. Cloud uses DENO_DEPLOYMENT_ID supplied by Supabase, never a custom value.
FAMILY_BILLING_SANDBOX_ENABLED=false
FAMILY_BILLING_TARGET_MODE=cloud
FAMILY_BILLING_SANDBOX_PROJECT_REF=
FAMILY_BILLING_SUPABASE_URL=
# Project-attributable legacy JWT keys required by this prototype (no fallback).
FAMILY_BILLING_SERVICE_ROLE_KEY=
FAMILY_BILLING_ANON_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH_SECRET=
FAMILY_BILLING_RECONCILE_SECRET=

# Default remains Sandbox. Production requires a separate reviewed deployment,
# matching project-attributed keys, release_ready DB gate AND enforced media policy.
FAMILY_BILLING_ENVIRONMENT=SANDBOX
FAMILY_BILLING_ENABLED=false
FAMILY_BILLING_RELEASE_APPROVED=false
# Required ONLY for a separately approved Production runtime, never inferred.
FAMILY_BILLING_PROJECT_REF=
