# Client-visible values only. Never put a secret/service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Phase 10A remains development-only until migration/security review is approved.
EXPO_PUBLIC_CHAT_ENABLED=false
# Disabled Phase 3 prototype. Public SDK key only; secret API/webhook keys belong
# in the isolated Edge runtime. Apple products/prices are configured manually.
EXPO_PUBLIC_FAMILY_BILLING_SANDBOX_ENABLED=false
EXPO_PUBLIC_FAMILY_BILLING_SANDBOX_HOST=
EXPO_PUBLIC_FAMILY_BILLING_TARGET_MODE=
EXPO_PUBLIC_FAMILY_BILLING_SANDBOX_PROJECT_REF=
EXPO_PUBLIC_REVENUECAT_APPLE_SANDBOX_KEY=
