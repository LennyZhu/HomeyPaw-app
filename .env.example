# Client-visible values only. Never put a secret/service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Phase 10A remains development-only until migration/security review is approved.
EXPO_PUBLIC_CHAT_ENABLED=false
# Disabled Phase 3 prototype. Public SDK key only; secret API/webhook keys belong
# in the isolated Edge runtime. Apple products/prices are configured manually.
EXPO_PUBLIC_FAMILY_BILLING_SANDBOX_ENABLED=false
EXPO_PUBLIC_FAMILY_BILLING_SANDBOX_HOST=
EXPO_PUBLIC_FAMILY_BILLING_TARGET_MODE=
EXPO_PUBLIC_FAMILY_BILLING_SANDBOX_PROJECT_REF=
EXPO_PUBLIC_REVENUECAT_APPLE_SANDBOX_KEY=

# Explicit DEV Sandbox client. No fallback to EXPO_PUBLIC_SUPABASE_* when selected.
EXPO_PUBLIC_HOMEYPAW_TARGET=
EXPO_PUBLIC_SANDBOX_SUPABASE_URL=https://yhxxsawcaffxonpconaq.supabase.co
EXPO_PUBLIC_SANDBOX_SUPABASE_PUBLISHABLE_KEY=
# Release remains OFF until backend, real StoreKit and media quotas pass.
EXPO_PUBLIC_FAMILY_PLUS_RELEASE_ENABLED=false
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
# Store targets are bound by eas.json + the pre-install target validator.
EXPO_PUBLIC_HOMEYPAW_BUILD_TARGET=
# Production's isolated, server-approved test-account page. No credentials here.
EXPO_PUBLIC_APP_REVIEW_ACCOUNT_ENABLED=false
