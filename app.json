{
  "expo": {
    "name": "HomeyPaw",
    "slug": "homeypaw",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/branding/homeypaw-app-icon.png",
    "scheme": "pawday",
    "userInterfaceStyle": "light",
    "locales": {
      "en": {
        "ios": {
          "CFBundleDisplayName": "HomeyPaw",
          "NSCameraUsageDescription": "HomeyPaw uses your camera only when you choose to take a photo for a pet journal entry.",
          "NSPhotoLibraryUsageDescription": "HomeyPaw needs access to your photos so you can choose pet profile pictures and share memories.",
          "NSPhotoLibraryAddUsageDescription": "HomeyPaw adds the current family journal photo only when you choose Save to Photos."
        }
      },
      "zh-HK": {
        "ios": {
          "CFBundleDisplayName": "HomeyPaw",
          "NSCameraUsageDescription": "HomeyPaw 只會在你選擇拍照時使用相機，讓你為毛孩記錄生活回憶。",
          "NSPhotoLibraryUsageDescription": "HomeyPaw 需要存取你的相片，讓你為毛孩選擇頭像及分享生活回憶。",
          "NSPhotoLibraryAddUsageDescription": "HomeyPaw 只會在你選擇「儲存到相片」時，將目前的家庭日記相片加入相片圖庫。"
        }
      }
    },
    "ios": {
      "icon": "./assets/branding/homeypaw-app-icon.png",
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.zhushunli.homeypaw",
      "buildNumber": "2",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zhushunli.homeypaw",
      "versionCode": 2,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"],
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F5",
        "foregroundImage": "./assets/branding/homeypaw-mark-transparent.png",
        "monochromeImage": "./assets/branding/homeypaw-mark-transparent.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/homeypaw-favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9F5",
          "image": "./assets/branding/homeypaw-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "HomeyPaw 需要存取你的相片，讓你為毛孩選擇頭像及分享生活回憶。",
          "cameraPermission": "HomeyPaw 只會在你選擇拍照時使用相機，讓你為毛孩記錄生活回憶。",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "HomeyPaw 需要存取你的相片，讓你為毛孩選擇頭像及分享生活回憶。",
          "savePhotosPermission": "HomeyPaw 只會在你選擇「儲存到相片」時，將目前的家庭日記相片加入相片圖庫。",
          "granularPermissions": ["photo"],
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "defaultChannel": "pawday-reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "3623de2b-5a77-48ec-b2ec-45e8136d9ac7"
      }
    },
    "owner": "homeypaw"
  }
}
